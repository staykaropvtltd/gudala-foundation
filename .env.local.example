# Copy this file to .env.local and fill in your values

# PostgreSQL connection string (Neon, Supabase, or any PostgreSQL provider)
# Get a free database at https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT secret — use any long random string (min 32 characters)
JWT_SECRET="replace-this-with-a-long-random-secret-string"

# Your website URL (localhost for dev, your domain for production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
